#include <winres.h>

1 VERSIONINFO
	FILEVERSION @FWMP_VERSION_MAJOR@, @FWMP_VERSION_MINOR@, @FWMP_VERSION_PATCH@, 0
	PRODUCTVERSION @FWMP_VERSION_MAJOR@, @FWMP_VERSION_MINOR@, @FWMP_VERSION_PATCH@, 0
	FILEFLAGSMASK 0x17L
#ifdef _DEBUG
	FILEFLAGS 0x1L
#else
	FILEFLAGS 0x0L
#endif
	FILEOS 0x4L
	FILETYPE 0x1L
	FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "Path of the Companions"
			VALUE "FileVersion", "@FWMP_VERSION@.0"
			VALUE "InternalName", "FightWithMePaths"
			VALUE "LegalCopyright", "GPL-3.0-or-later"
			VALUE "ProductName", "Path of the Companions"
			VALUE "ProductVersion", "@FWMP_VERSION@.0"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
